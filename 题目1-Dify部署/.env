# Dify 部署关键环境变量（摘自实际部署 .env，敏感值已脱敏）
# 完整模板见官方 dify/docker/.env.example，部署时执行 cp .env.example .env

# ------- 访问端口 -------
EXPOSE_NGINX_PORT=7090        # Web 访问端口（http://localhost:7090）
EXPOSE_NGINX_SSL_PORT=7443    # HTTPS 端口

# ------- 数据库（PostgreSQL）-------
DB_HOST=db_postgres           # 数据库容器名（compose 内部网络解析）
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=********（已脱敏）
DB_DATABASE=dify

# ------- 缓存（Redis）-------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=********（已脱敏）

# ------- 向量数据库 -------
VECTOR_STORE=weaviate         # 使用 Weaviate 作为向量库

# ------- 安全密钥 -------
SECRET_KEY=********（已脱敏） # 首次部署时生成的随机密钥

# ------- 插件守护进程 -------
PLUGIN_DAEMON_PORT=5002
PLUGIN_DAEMON_KEY=********（已脱敏）

# ------- 代码沙箱 -------
SANDBOX_PORT=8194
